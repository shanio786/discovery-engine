# ------------------------------------------------------------------
# Opportunity Discovery Engine — secrets. Copy to `.env` (chmod 600).
# NEVER commit the real .env (it is git-ignored).
# Wikipedia, Wikidata and Hacker News need NO keys. YouTube and Reddit
# collectors skip themselves cleanly until their keys are set.
# ------------------------------------------------------------------

# REQUIRED. Database password (long + random):  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Used when running `ode` directly on the host (not inside docker compose,
# which builds its own URL from POSTGRES_PASSWORD).
DATABASE_URL=postgresql://ode:change-me@localhost:5432/ode

# YouTube Data API v3 — https://console.cloud.google.com (free, 10k units/day)
YOUTUBE_API_KEY=

# Reddit app, type "script" — https://www.reddit.com/prefs/apps (free)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ode:discovery-engine:v0.2 (by /u/yourname)

# Phase 4 (paid, hard-capped verify layer) — leave blank for now
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: Gemini briefs (titles + outline) for the top 5 actions per day.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: DEBUG | INFO | WARNING
ODE_LOG_LEVEL=INFO
