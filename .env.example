# ------------------------------------------------------------------
# Opportunity Discovery Engine — environment secrets
# Copy to `.env` and fill in. NEVER commit the real .env.
# Phase 1 runs with ZERO keys for Wikipedia + HackerNews.
# YouTube + Reddit collectors self-skip (gracefully) until keys exist.
# ------------------------------------------------------------------

# Postgres / TimescaleDB (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://ode:ode@localhost:5432/ode

# YouTube Data API v3 — https://console.cloud.google.com (free, 10k units/day)
YOUTUBE_API_KEY=

# Reddit app (script type) — https://www.reddit.com/prefs/apps (free)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ode:discovery-engine:v0.1 (by /u/yourname)

# DataForSEO — Phase 4 ONLY (paid verify layer, hard-capped). Leave blank for now.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Gemini — Phase 8 (brief generation). Leave blank for now.
GEMINI_API_KEY=
