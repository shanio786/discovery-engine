# Opportunity Discovery Engine — host crontab (VPS).
# Install:  crontab cron/crontab      (repo at /opt/discovery-engine)
# Every job is idempotent and protected by a database lock, so a slow run
# and the next scheduled one can never corrupt or duplicate data.

# Full cycle daily at 04:17 UTC: schema -> discover -> collect.
17 4 * * *  /opt/discovery-engine/scripts/run.sh daily

# Midday Wikipedia refresh (catches late-published days; cheap).
17 16 * * * /opt/discovery-engine/scripts/run.sh collect --source wikipedia

# Nightly database backup at 03:07 UTC (14 days kept).
7 3 * * *   /opt/discovery-engine/scripts/backup.sh >> /opt/discovery-engine/logs/backup.log 2>&1
